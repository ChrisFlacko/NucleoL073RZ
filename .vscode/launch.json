{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug (OpenOCD)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/EMPTY.elf",
            "args": [],
            "stopAtEntry": true,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/Applications/ArmGNUToolchain/15.2.rel1/arm-none-eabi/bin/arm-none-eabi-gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "miDebuggerServerAddress": "localhost:3333",
            "serverLaunchTimeout": 5000,
            "filterStderr": true,
            "targetArchitecture": "arm",
            "customLaunchSetupCommands": [
                { "text": "file ${workspaceFolder}/build/EMPTY.elf" },
                { "text": "target extended-remote localhost:3333" },
                { "text": "monitor reset halt" },
                { "text": "load" },
                { "text": "monitor reset halt" },
                { "text": "break main" }
            ],
            "postRemoteConnectCommands": [
                { "text": "continue" }
            ],
            "preLaunchTask": "Start OpenOCD"
        }
    ]
}
